{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:REGION:ACCOUNT_ID:*"
    },
    {
      "Sid": "AgentCoreList",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:ListHarnesses",
        "bedrock-agentcore:ListAgentRuntimes"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WatchedHarnesses",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:GetHarness",
        "bedrock-agentcore:UpdateHarness"
      ],
      "Resource": [
        "arn:aws:bedrock-agentcore:REGION:ACCOUNT_ID:harness/UI_HARNESS_ID",
        "arn:aws:bedrock-agentcore:REGION:ACCOUNT_ID:harness/BUGFIX_HARNESS_ID"
      ]
    },
    {
      "Sid": "RunQaInvoke",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:InvokeHarness",
        "bedrock-agentcore:InvokeAgentRuntime"
      ],
      "Resource": "arn:aws:bedrock-agentcore:REGION:ACCOUNT_ID:harness/UI_HARNESS_ID"
    },
    {
      "Sid": "WatchedHarnessRuntimesUpdate",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:UpdateAgentRuntime",
        "bedrock-agentcore:GetAgentRuntime"
      ],
      "Resource": [
        "arn:aws:bedrock-agentcore:REGION:ACCOUNT_ID:runtime/harness_UI_HARNESS_NAME-*",
        "arn:aws:bedrock-agentcore:REGION:ACCOUNT_ID:runtime/harness_BUGFIX_HARNESS_NAME-*"
      ]
    },
    {
      "Sid": "PassHarnessExecutionRoles",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "UI_HARNESS_ROLE_ARN",
        "BUGFIX_HARNESS_ROLE_ARN"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "bedrock-agentcore.amazonaws.com"
        }
      }
    },
    {
      "Sid": "EvalRead",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:ListEvaluators",
        "bedrock-agentcore:GetEvaluator",
        "bedrock-agentcore:ListOnlineEvaluationConfigs",
        "bedrock-agentcore:GetOnlineEvaluationConfig"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CWMetricsRead",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricData",
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CostExplorerRead",
      "Effect": "Allow",
      "Action": [
        "ce:GetCostAndUsage"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AgentCoreLogsRead",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogStreams",
        "logs:StartQuery",
        "logs:GetQueryResults",
        "logs:FilterLogEvents",
        "logs:GetLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/aws/bedrock-agentcore*",
        "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/aws/bedrock-agentcore*:*",
        "arn:aws:logs:REGION:ACCOUNT_ID:log-group:aws/spans",
        "arn:aws:logs:REGION:ACCOUNT_ID:log-group:aws/spans:*"
      ]
    },
    {
      "Sid": "LogsDescribeAndFas",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:PutRetentionPolicy",
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Bedrock",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3Reports",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::QA_BUCKET",
        "arn:aws:s3:::QA_BUCKET/*"
      ]
    },
    {
      "Sid": "DDB",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:GetItem",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/AgentAdminRuns"
    },
    {
      "Sid": "SelfInvoke",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:REGION:ACCOUNT_ID:function:agent-cicd-admin"
    },
    {
      "Sid": "CognitoAuth",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:InitiateAuth",
        "cognito-idp:GetUser"
      ],
      "Resource": "*"
    },
    {
      "Sid": "STS",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}
